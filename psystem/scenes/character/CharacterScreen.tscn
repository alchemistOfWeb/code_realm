[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/character/CharacterScreen.gd" id="1_char"]
[ext_resource type="Texture2D" path="res://assets/icons/arrow-left.svg" id="2_back"]
[ext_resource type="Shader" path="res://shaders/orb.gdshader" id="3_orb"]
[ext_resource type="Texture2D" path="res://assets/icons/user.svg" id="4_user"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_avatar"]
resource_local_to_scene = true
shader = ExtResource("3_orb")
shader_parameter/orb_color = Color(0.482, 0.408, 0.933, 1)
shader_parameter/ring_color = Color(0, 0.83, 0.67, 1)
shader_parameter/progress = 0.0
shader_parameter/hover = 0.0
shader_parameter/seed = 2.0
shader_parameter/show_ring = true

[node name="CharacterScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_char")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
