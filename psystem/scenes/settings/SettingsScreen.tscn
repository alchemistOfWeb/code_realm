[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/settings/SettingsScreen.gd" id="1_settings"]
[ext_resource type="Texture2D" path="res://assets/icons/arrow-left.svg" id="2_back"]
[ext_resource type="Texture2D" path="res://assets/icons/rotate-ccw.svg" id="3_reset"]

[node name="SettingsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_settings")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Назад (Esc)"
text = "Назад"
icon = ExtResource("2_back")

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 26
text = "Настройки"

[node name="ResetButton" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"GhostButton"
text = "Сбросить настройки"
icon = ExtResource("3_reset")

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Columns" type="HBoxContainer" parent="Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 18

[node name="ScreenPanel" type="PanelContainer" parent="Margin/VBox/Scroll/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"

[node name="ScreenBox" type="VBoxContainer" parent="Margin/VBox/Scroll/Columns/ScreenPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14

[node name="SoundPanel" type="PanelContainer" parent="Margin/VBox/Scroll/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"

[node name="SoundBox" type="VBoxContainer" parent="Margin/VBox/Scroll/Columns/SoundPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14

[node name="Credits" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 12
text = "Звуки, 3D-модели: Kenney (CC0). Фанфары: Spring Spring (CC-BY 4.0 / CC0). Музыка: isaiah658, Cleyton Kauffman, «Heartfelt Battle» — OpenGameArt (CC0). Иконки карт и мира: Lorc, Delapouite, Skoll, Faithtoken, Caro Asercion, Darkzaitzev — game-icons.net (CC BY 3.0). Иконки UI: Lucide (ISC). Шрифты: JetBrains Mono, Inter, Unbounded (OFL)."
autowrap_mode = 3
