[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/knowledge/TestScreen.gd" id="1_test"]
[ext_resource type="Texture2D" path="res://assets/icons/arrow-left.svg" id="2_back"]
[ext_resource type="Texture2D" path="res://assets/icons/chevron-right.svg" id="3_next"]
[ext_resource type="Texture2D" path="res://assets/icons/game/scroll-quill.svg" id="4_quill"]

[node name="TestScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_test")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Выйти из теста (Esc) — прогресс теста не сохраняется"
text = "Выйти"
icon = ExtResource("2_back")

[node name="QuillIcon" type="TextureRect" parent="Margin/VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("4_quill")
expand_mode = 1
stretch_mode = 5

[node name="TitleBox" type="VBoxContainer" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Subtitle" type="Label" parent="Margin/VBox/Header/TitleBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Общий тест"

[node name="Title" type="Label" parent="Margin/VBox/Header/TitleBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 22
text = "Тест"
text_overrun_behavior = 3

[node name="StatsBox" type="VBoxContainer" parent="Margin/VBox/Header"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 4

[node name="ProgressLabel" type="Label" parent="Margin/VBox/Header/StatsBox"]
unique_name_in_owner = true
layout_mode = 2
